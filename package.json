{
  "name": "signalk-navico-autopilot-bridge",
  "version": "0.8.1-beta",
  "description": "Emulate a Simrad AC12/AC42 so a Navico MFD (B&G/Simrad/Lowrance) drives any SignalK Autopilot V2 pilot (e.g. a Raymarine EV-200) from its own autopilot control view. Beta — see README for verified behaviour and known limitations.",
  "main": "index.js",
  "signalk": {
    "appIcon": "favicon.svg",
    "displayName": "Autopilot — Navico bridge",
    "screenshots": ["screenshot.png"],
    "recommends": [
      "@signalk/signalk-autopilot",
      "pypilot-autopilot-provider",
      "signalk-autopilot-provider-garmin"
    ]
  },
  "scripts": {
    "test": "node --test --test-force-exit"
  },
  "devDependencies": {
    "@canboat/canboatjs": "^3.20.0"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-hardware",
    "signalk-category-nmea-2000",
    "nmea2000",
    "autopilot",
    "navico",
    "simrad",
    "bng",
    "ac42",
    "ac12"
  ],
  "files": [
    "index.js",
    "lib/",
    "public/",
    "screenshot.png",
    "README.md",
    "PROTOCOL-REFERENCE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@canboat/canboatjs": ">=2.10.0"
  },
  "peerDependenciesMeta": {
    "@canboat/canboatjs": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johansolve/signalk-navico-autopilot-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/johansolve/signalk-navico-autopilot-bridge/issues"
  },
  "homepage": "https://github.com/johansolve/signalk-navico-autopilot-bridge#readme",
  "author": "Johan Sölve (https://github.com/johansolve)",
  "license": "MIT"
}
